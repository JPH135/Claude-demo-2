# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_api_key_here

# Database path (optional, defaults to ./fintech_tracker.db)
DB_PATH=./fintech_tracker.db

# Report output path (optional, defaults to ./report.html)
REPORT_PATH=./report.html

# Max articles to fetch per RSS feed (optional, default 20)
MAX_ARTICLES_PER_FEED=20

# Max article content length sent to Claude in chars (optional, default 8000)
MAX_CONTENT_LENGTH=8000

# Delay between Claude API calls in seconds (optional, default 1)
API_DELAY_SECONDS=1
